{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://commerce.kujolang.ai/schemas/event/v1","title":"Kujo Commerce Normalized Event v1","type":"object","additionalProperties":false,"required":["schema","event_version","provider","type","provider_event_id","provider_object_id","skus","timestamp"],"properties":{"schema":{"const":"kujo-commerce-event/v1"},"event_version":{"const":1},"provider":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"type":{"enum":["commerce.checkout.approved","commerce.checkout.completed","commerce.order.created","commerce.order.updated","commerce.subscription.created","commerce.subscription.updated","commerce.subscription.cancelled","commerce.refund.created","commerce.customer.updated","commerce.payment.failed","commerce.unknown"]},"provider_event_id":{"type":"string","minLength":1,"maxLength":255},"provider_object_id":{"type":"string","maxLength":255},"skus":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},"timestamp":{"type":"string","format":"date-time"}}}
