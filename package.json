{
  "name": "@kujolang/commerce",
  "version": "0.4.0",
  "description": "Provider-agnostic commerce for static sites with first-class Kujo SSG integration",
  "keywords": ["static-site", "commerce", "ecommerce", "ssg", "hosted-checkout", "edge"],
  "repository": { "type": "git", "url": "git+https://github.com/kujolang/commerce.git" },
  "homepage": "https://github.com/kujolang/commerce#readme",
  "bugs": { "url": "https://github.com/kujolang/commerce/issues" },
  "type": "module",
  "bin": { "kujo-commerce": "bin/kujo-commerce.mjs" },
  "exports": {
    ".": "./src/index.mjs",
    "./runtime": "./runtime/index.mjs",
    "./runtime/cloudflare": "./runtime/cloudflare.mjs",
    "./runtime/node": "./runtime/node.mjs",
    "./runtime/vercel": "./runtime/vercel.mjs",
    "./runtime/netlify": "./runtime/netlify.mjs",
    "./conformance": "./src/conformance.mjs",
    "./browser/*": "./browser/*",
    "./schemas/*": "./schemas/*"
  },
  "files": ["bin", "src", "runtime", "browser", "schemas", "docs", "examples", "README.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:sandbox": "node --test test/sandbox/*.sandbox.mjs",
    "test:schemas": "node --test test/schema.test.mjs",
    "security:patterns": "node scripts/security-patterns.mjs",
    "validate": "node --check bin/kujo-commerce.mjs && node --check runtime/index.mjs && node --check browser/commerce.js && npm run security:patterns && npm test"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": { "@playwright/test": "^1.55.0", "ajv": "^8.17.1", "ajv-formats": "^3.0.1" },
  "license": "MIT"
}
